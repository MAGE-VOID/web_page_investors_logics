  "narrative": {
    "northStar": "Night Desk",
    "overview": "A quiet, product-led software storefront: GitHub-inspired graphite surfaces, blue links and solid blue actions with white text, paired with regular-width typography. Hierarchy comes from spacing, two-weight headings and clear choices. Controls, enquiries and documentation remain dark throughout.\n\nThe recognizable Investors Logics wordmark and original two-candle identity remain binding assets. Dimensional artwork adds identity without pretending to show hardware, trading results or private strategy. English copy and semantic native interactions keep comprehension independent of WebGL.",
    "keyCharacteristics": [
      "GitHub-inspired graphite surfaces with blue links, actions and meaningful state.",
      "Regular-width Barlow and two-weight product headings.",
      "Tonal panels, thin boundaries and restrained interface motion.",
      "Recognizable brand artwork with complete static fallback."
    ],
    "rules": [
      {
        "name": "The One Dark World Rule",
        "body": "Enquiry forms, fields, documentation and navigation stay dark; legacy porcelain aliases do not authorize cool-paper regions.",
        "section": "colors"
      },
      {
        "name": "The One Family Rule",
        "body": "Use Barlow 400/500/600 across display, interface and reading text. Reserve monospace for genuine code or file notation.",
        "section": "typography"
      },
      {
        "name": "The Flat Interface, Dimensional Identity Rule",
        "body": "Keep controls and content panels tonal and steady. Confine sculptural reflections and dimensional depth to brand artwork.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use shared graphite tokens and separate blue link, selection and action roles.",
      "Do preserve the recognizable wordmark and original two-candle identity.",
      "Do keep explanations, prices and controls in semantic HTML.",
      "Do retain native radios, disclosures, visible focus and reduced-motion support.",
      "Do keep licensing limitations and email-enquiry boundaries close to commercial actions.",
      "Do preserve the SVG fallback and confine the renderer to the homepage."
    ],
    "donts": [
      "Don't restore mint accents, cool-paper surfaces or condensed display as the current system.",
      "Don't copy competitor identity or imply additional bots from a catalog layout.",
      "Don't imply guaranteed returns, fabricated results, private strategy disclosure or connected checkout.",
      "Don't add artwork captions, Pause/Play controls or the retired platform/file hero footer.",
      "Don't treat historical mocks, source review or declared budgets as rendered approval or measured performance."
    ]
  }
